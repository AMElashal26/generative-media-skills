{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/social-media-engine/campaign.schema.json",
  "title": "Social Media Engine Campaign",
  "type": "object",
  "required": ["campaign_id", "name", "objective", "platforms", "created_at"],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "brand_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cadence": {
      "type": "string",
      "description": "Human-readable cadence such as daily, weekly, or launch burst."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
